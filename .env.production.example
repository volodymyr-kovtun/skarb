# Copy to /opt/skarb/.env.production on the server and fill in the blanks.
# This file is read by docker compose (--env-file), not by the app directly.

# --- database ---
POSTGRES_DB=skarb
POSTGRES_USER=skarb
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- app ---
# Public URL, used by the deploy workflow's health check.
APP_BASE_URL=https://skarb.subero.app
# One-time first-run claim token. Generate one (openssl rand -hex 16) or leave empty
# to have Skarb generate it and print it to the container log on first boot.
AUTH_SETUP_TOKEN=
# The day the ledger opens (optional), e.g. 2026-08-01. Empty = sync full history window.
SYNC_START_DATE=

# --- images (set by the deploy workflow; only needed for manual compose runs) ---
GHCR_REPOSITORY=volodymyr-kovtun/skarb
IMAGE_TAG=production

# --- backups ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- proxy trust ---
# Network the shared Caddy proxy connects from (Docker's default bridge pool).
FORWARDED_HEADERS_NETWORK=172.16.0.0/12
