# .NET
bin/
obj/
*.user
backend/Skarb.Api/wwwroot/

# Node
node_modules/
dist/
*.local

# Secrets — private keys never belong in the repo
*.pem
*.key

# Local-only secrets (account recovery codes, tokens) — stays on this machine
.secrets/

# Production env file lives on the server, never in the repo (.env.production.example is the template)
.env.production

# Data-protection key ring (encrypts the session cookie)
keys/
backend/Skarb.Api/keys/

# OS / editor
.DS_Store
.vs/
.idea/

# Keep the lockfile even if a global gitignore excludes it (reproducible CI installs)
!frontend/package-lock.json

# Keep the Claude Code guide even if a global gitignore excludes it
!CLAUDE.md
