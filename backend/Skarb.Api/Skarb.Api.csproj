<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Per-instance settings (Sync:StartDate, …) live in the machine's user-secret store,
         never in the tracked appsettings.json — see docs/BANKS.md. -->
    <UserSecretsId>032aec9e-ce4e-4961-95e5-9786e2bc51e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skarb.Api.Tests" />
  </ItemGroup>

  <!--
    The API serves the SPA out of wwwroot, so a stale wwwroot means the Run button shows
    yesterday's UI. Build it as part of building the API — Rider, `dotnet run` and
    `make run` all go through here. Only reruns when the frontend actually changed;
    opt out with -p:SkipSpa=true when you want the backend alone.
  -->
  <PropertyGroup>
    <SpaDir>$(MSBuildProjectDirectory)/../../frontend</SpaDir>
  </PropertyGroup>

  <ItemGroup>
    <SpaInput Include="$(SpaDir)/src/**/*;$(SpaDir)/index.html;$(SpaDir)/package.json;$(SpaDir)/vite.config.ts;$(SpaDir)/tsconfig*.json" />
  </ItemGroup>

  <Target Name="BuildSpa" BeforeTargets="Build"
          Condition="'$(SkipSpa)' != 'true' And Exists('$(SpaDir)/node_modules')"
          Inputs="@(SpaInput)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html">
    <Exec Command="npm run build" WorkingDirectory="$(SpaDir)" />
  </Target>

  <!-- Saying so beats silently serving an old bundle. CI hits this: it builds the
       backend before `npm ci` and builds the SPA in a step of its own. -->
  <Target Name="ReportMissingSpaDeps" BeforeTargets="Build"
          Condition="'$(SkipSpa)' != 'true' And !Exists('$(SpaDir)/node_modules')">
    <Message Importance="high"
             Text="Skipping the SPA build: frontend/node_modules is missing, so wwwroot keeps whatever was built last. Run `make install` to change that." />
  </Target>

</Project>
